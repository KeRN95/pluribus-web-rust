{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.name, m.slug, county.name AS county\n         FROM locations m\n         JOIN locations county ON county.id = m.parent_id\n         WHERE m.location_type = 'MUNICIPALITY' AND m.active\n         ORDER BY county.name, m.slug <> county.slug, m.name",
