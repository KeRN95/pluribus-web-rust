# Copy to .env for local development. sqlx's compile-time checks also read DATABASE_URL.
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace
BIND_ADDR=127.0.0.1:3000
RUST_LOG=marketplace=debug,tower_http=info

# Sending sign-in codes (src/sender.rs). A channel left out writes its codes to the server's log.
# E-mail, by SMTP: any e-mail service (Amazon SES, Postmark, Brevo...). Port 587 uses STARTTLS, 465 TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Pluribus <kodi@example.com>
# Phone numbers, by WhatsApp: Meta's WhatsApp Cloud API with an approved authentication template
# (category Authentication, with a "copy code" button). The token is a system user's permanent one.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=sq
WHATSAPP_API_VERSION=v21.0

# Photos, in an S3-compatible store (src/media.rs). Locally, Garage from compose.yaml: run
# `sh dev/setup_garage.sh` once, and these values work as they are. In production, Cloudflare R2:
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, S3_REGION=auto, an R2 bucket and an
# R2 API token's key id and secret. Copy the photos across with rclone (README). Without these,
# photos are kept in memory only.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=marketplace-media
S3_REGION=garage
S3_ACCESS_KEY_ID=GKcdbe83a981b604008ecaaa58
S3_SECRET_ACCESS_KEY=e53a24e44d0b706f7de2cabfc08e168d47ef3a4af989acdeb8d0eaf48834d379
# Where pages say the photos are: under /media, which the site serves itself, unless MEDIA_URL
# names a CDN that serves the bucket, such as an R2 bucket's public domain (README, "Photos").
# MEDIA_URL=https://foto.example.al

# Test mode: the sign-in page shows the code instead of sending it, so anyone can sign in as any
# number. Only for trying the site before an SMS or e-mail provider is connected.
SIGN_IN_CODES_ON_SCREEN=false

# The listing form's "Plotëso pjesën tjetër me AI" (src/ai.rs, src/web/ai_fill.rs): a key from the
# Anthropic Console (console.anthropic.com). Without one, the form has no AI. ANTHROPIC_MODEL names
# another model than Haiku 4.5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Moderators: the phone numbers and e-mail addresses, comma-separated, of the people who may
# approve the makes, models and brands sellers type in ("Tjetër"), on /moderim. Signed in with one
# of them, "Njoftimet e mia" links to it. In test mode (above), anyone can sign in as any number,
# so this page is only as safe as that.
MODERATORS=
