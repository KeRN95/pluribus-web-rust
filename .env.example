# Copy to .env for local development. sqlx's compile-time checks also read DATABASE_URL.
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace
BIND_ADDR=127.0.0.1:3000
RUST_LOG=marketplace=debug,pluribus=debug,tower_http=info

# The site's address, which the links it gives of itself start with: the photos link previews
# show, the sitemaps' addresses and robots.txt's (crates/web/src/seo.rs). Unset, the address each
# request came to: its Host, over https when the proxy in front says so (X-Forwarded-Proto), as
# Cloudflare's tunnel does. Set it where the proxy names another host: PUBLIC_URL=https://pluribus.al
# The links in the notices of unread messages (crates/services/src/notices.rs) have no request to
# go by: they start with it, or without it with http://127.0.0.1:3000, so set it wherever notices
# go out.
PUBLIC_URL=

# Sending sign-in codes (crates/services/src/sender.rs). A channel left out writes its codes to the
# server's log.
# E-mail, by SMTP: any e-mail service (Amazon SES, Postmark, Brevo...). Port 587 uses STARTTLS, 465 TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Pluribus <kodi@example.com>
# Phone numbers, by WhatsApp: Meta's WhatsApp Cloud API with an approved authentication template
# (category Authentication, with a "copy code" button). The token is a system user's permanent one.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=sq
WHATSAPP_API_VERSION=v21.0
# Notices of messages someone hasn't read (crates/services/src/notices.rs) reach phone numbers by
# WhatsApp too with a second approved template, of category Utility: its body naming who wrote
# ({{1}}) and about what ({{2}}), and a URL button whose address ends in the conversation ({{1}}),
# as https://pluribus.al/mesazhet/{{1}}. Without it, phone numbers get no notices; e-mail addresses
# get them through SMTP as the codes do.
WHATSAPP_NOTICE_TEMPLATE=
# Saved searches' alerts (crates/web/src/searches.rs), the same way: a Utility template whose body
# says how many new listings ({{1}}) a search of what name ({{2}}) has, as "Ka {{1}} te kërkimi yt
# „{{2}}“ në Pluribus.", and whose URL button opens the search, its address ending in its id
# ({{1}}), as https://pluribus.al/kerkimet/{{1}}.
WHATSAPP_SEARCH_TEMPLATE=
# Listings about to expire or expired (crates/services/src/expiry.rs): a Utility template whose
# body names the listing ({{1}}) and what becomes of it ({{2}}: "skadon më 16.10.2026", or
# "skadoi"), as "Njoftimi yt „{{1}}“ në Pluribus {{2}}. Rifreskoje që të qëndrojë 60 ditë të tjera.",
# and whose URL button opens https://pluribus.al/njoftimet-e-mia, the same for all.
WHATSAPP_EXPIRY_TEMPLATE=

# Photos, in an S3-compatible store (crates/services/src/media.rs). Locally, Garage from
# compose.yaml: run `sh dev/setup_garage.sh` once, and these values work as they are. In
# production, Cloudflare R2:
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, S3_REGION=auto, an R2 bucket and an
# R2 API token's key id and secret. Copy the photos across with rclone (README). Without these,
# photos are kept in memory only.
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=marketplace-media
S3_REGION=garage
S3_ACCESS_KEY_ID=GKcdbe83a981b604008ecaaa58
S3_SECRET_ACCESS_KEY=e53a24e44d0b706f7de2cabfc08e168d47ef3a4af989acdeb8d0eaf48834d379
# Where pages say the photos are: under /media, which the site serves itself, unless MEDIA_URL
# names a CDN that serves the bucket, such as an R2 bucket's public domain (README, "Photos").
# MEDIA_URL=https://foto.example.al

# Test mode: the sign-in page shows the code instead of sending it, so anyone can sign in as any
# number. Only for trying the site before an SMS or e-mail provider is connected.
SIGN_IN_CODES_ON_SCREEN=false

# Trying typefaces: an "Aa" button in the top bar picks the headings' and the text's typeface and
# weights for that browser alone, from the site's own and Google Fonts'. Only while the look is
# being settled.
TYPE_TRIAL=false

# The listing form's "Plotëso pjesën tjetër me AI" (crates/services/src/ai.rs,
# crates/web/src/ai_fill.rs): a key from the Anthropic Console (console.anthropic.com). Without
# one, the form has no AI. ANTHROPIC_MODEL names another model than Haiku 4.5.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Moderators: the phone numbers and e-mail addresses, comma-separated, of the people who may
# approve the makes, models and brands sellers type in ("Tjetër"), on /moderim. Signed in with one
# of them, "Njoftimet e mia" links to it. In test mode (above), anyone can sign in as any number,
# so this page is only as safe as that.
MODERATORS=

# The e-mail address the contact page (/kontakt) gives. Without one, the page gives no address,
# only the quicker ways for what has one of its own (Raporto, Blloko).
CONTACT_EMAIL=
